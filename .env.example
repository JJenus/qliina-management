# Copy to `.env` and fill in real values. Required by docker-compose.yml —
# compose fails fast if these are missing (no committed defaults).
#
# PostgreSQL (infra) credentials
POSTGRES_PASSWORD=change-me

# Backend secrets — the app's prod profile (`SPRING_PROFILES_ACTIVE=prod`)
# also requires JWT_SECRET, ENCRYPTION_SECRET, ENCRYPTION_SALT and
# BILLING_GATEWAY_SECRET to be set (see application-prod.yml).
JWT_SECRET=change-me-64-hex-chars-min
ENCRYPTION_SECRET=change-me-32-byte-base64
ENCRYPTION_SALT=change-me-16-byte-hex
BILLING_GATEWAY_SECRET=change-me

# Bootstrap (first boot only, then set back to false / unset):
#   SPRING_PROFILES_ACTIVE=prod
#   SEED_ADMIN_ENABLED=true
#   SEED_ADMIN_PASSWORD=<strong password for the initial 'admin' superadmin>
# Permissions, roles and billing plans (credential-free reference data) always
# seed in prod; only the admin bootstrap is gated by SEED_ADMIN_ENABLED.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_PASSWORD=